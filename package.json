{
  "name": "pixel3d-renderer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "golden": "node tools/golden.mjs",
    "golden:update": "node tools/golden.mjs --update",
    "verify": "node tools/verify.mjs && node tools/check-viewer.mjs && node tools/anim-check.mjs",
    "check": "npm run typecheck && npm run golden && npm run verify"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
