{
  "name": "pixel3d-renderer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tools",
    "browser:install": "node tools/install-browser.ts",
    "golden": "node tools/golden.ts",
    "golden:update": "node tools/golden.ts --update",
    "thin-check": "node tools/thin-check.ts",
    "lamp-shadow-check": "node tools/lamp-shadow-check.ts",
    "village-check": "node tools/village-check.ts",
    "moving-shadow-check": "node tools/moving-shadow-check.ts",
    "resolve-check": "node tools/resolve-check.ts",
    "window-light-check": "node tools/window-light-check.ts",
    "water-check": "node tools/water-check.ts",
    "camera-check": "node tools/camera-check.ts",
    "object-check": "node tools/object-check.ts",
    "pick-check": "node tools/pick-check.ts",
    "settings-check": "node tools/settings-check.ts",
    "object-bench": "node tools/object-bench.ts",
    "verify": "node tools/verify.ts && node tools/check-viewer.ts && node tools/anim-check.ts",
    "check": "npm run typecheck && npm run lamp-shadow-check && npm run moving-shadow-check && npm run village-check && npm run resolve-check && npm run window-light-check && npm run water-check && npm run camera-check && npm run object-check && npm run pick-check && npm run settings-check && npm run golden && npm run verify"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.3",
    "@types/node": "^26.6.4",
    "@types/three": "^0.180.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
